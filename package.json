    "@sentry/react": "^10.69.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "filecoin-pin": "^1.3.0",
    "lucide-react": "^1.30.0",
    "multiformats": "^14.0.0",
    "pino": "^10.0.0",
    "pretty-bytes": "^7.1.1",
    "react": "^19.2.8",
